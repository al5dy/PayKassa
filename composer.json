{
  "name": "al5dy/paykassa-for-woocommerce",
  "description": "PayKassa for WooCommerce",
  "type": "wordpress-plugin",
  "license": "GPL-3.0-or-later",
  "require": {
    "php": ">=8.1"
  },
  "require-dev": {
    "php-stubs/woocommerce-stubs": "^11.1",
    "php-stubs/wordpress-stubs": "^7.1",
    "phpstan/phpstan": "^2.2",
    "phpunit/phpunit": "^10.5",
    "squizlabs/php_codesniffer": "^3.10"
  },
  "autoload": {
    "psr-4": {
      "Al5dy\\PayKassaWoo\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "PayKassaWoo\\Tests\\": "tests/"
    }
  },
  "scripts": {
    "test": "phpunit --colors=always",
    "lint": "phpcs --standard=phpcs.xml.dist",
    "stan": "phpstan analyse --memory-limit=1G",
    "syntax": "find src -name '*.php' -print0 | xargs -0 -n1 php -l"
  },
  "config": {
    "sort-packages": true
  }
}
